{
  "expo": {
    "name": "GoViet247 Driver",
    "slug": "driver-mobile",
    "version": "1.1.7",
    "icon": "./assets/images/GoViet247_driver_icon.png",
    "scheme": "drivermobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goviet247.driver",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/GoViet247_driver_icon.png",
        "backgroundImage": "./assets/images/GoViet247_driver_icon.png",
        "monochromeImage": "./assets/images/GoViet247_driver_icon.png"
      },
      "icon": "./assets/images/GoViet247_driver_icon.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.goviet247.driver",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/GoViet247_driver_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/GoViet247_driver_icon.png",
          "color": "#F97316",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/new_trip.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/GoViet247_driver_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "./plugins/withAndroid16Compatibility",
      [
        "expo-av",
        {
          "microphonePermission": "Cho phép GoViet247 dùng micro để bạn và khách hàng gọi cho nhau, và gửi tin nhắn thoại."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép GoViet247 lấy vị trí khi bạn chọn gửi vị trí trong hội thoại."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép GoViet247 chụp ảnh để gửi trong hội thoại chuyến.",
          "photosPermission": "Cho phép GoViet247 chọn ảnh để gửi trong hội thoại chuyến.",
          "microphonePermission": "Cho phép GoViet247 dùng micro để bạn và khách hàng gọi cho nhau, và gửi tin nhắn thoại."
        }
      ],
      "@goviet247/trip-calling-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9dea1825-d6e0-4f7c-adea-b55c42a07359"
      }
    },
    "owner": "dangnguyen080910"
  }
}
