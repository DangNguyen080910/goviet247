{
  "expo": {
    "name": "GoViet247 Driver",
    "slug": "driver-mobile",
    "version": "1.0.4",
    "icon": "./assets/images/GoViet247_driver_icon.png",
    "scheme": "drivermobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goviet247.driver",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/GoViet247_driver_icon.png",
        "backgroundImage": "./assets/images/GoViet247_driver_icon.png",
        "monochromeImage": "./assets/images/GoViet247_driver_icon.png"
      },
      "icon": "./assets/images/GoViet247_driver_icon.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.goviet247.driver"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/GoViet247_driver_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/GoViet247_driver_icon.png",
          "color": "#F97316",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/GoViet247_driver_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "./plugins/withAndroid16Compatibility"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9dea1825-d6e0-4f7c-adea-b55c42a07359"
      }
    },
    "owner": "dangnguyen080910"
  }
}
