{
  "expo": {
    "name": "GoViet247",
    "slug": "rider-mobile",
    "version": "1.0.7",
    "icon": "./assets/GoViet247_icon.png",
    "scheme": "ridermobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goviet247.rider",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "GoViet247 uses your location to help you choose pickup and destination points more quickly and accurately when booking rides."
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/GoViet247_icon.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/GoViet247_icon.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.goviet247.rider",
      "googleServicesFile": "./google-services.json"
    },

    "web": {
      "favicon": "./assets/GoViet247_icon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-notifications",
        {
          "icon": "./assets/GoViet247_icon.png",
          "color": "#F97316",
          "defaultChannel": "default"
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/GoViet247_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "./plugins/withAndroid16Compatibility"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "15acfa07-3080-44a9-a756-de160f897561"
      }
    },

    "owner": "dangnguyen080910"
  }
}
