{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckPrivateChatBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketPublicAccessBlock",
      "Resource": "arn:aws:s3:::goviet247-trip-chat-private"
    },
    {
      "Sid": "ReadWriteChatFiles",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::goviet247-trip-chat-private/trip-chat/*"
    }
  ]
}
