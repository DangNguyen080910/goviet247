{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadForPublicFolderOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::goviet247-prod/public/*"
    },
    {
      "Sid": "PublicReadForSystemConfig",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::goviet247-prod/system-config/*"
    },
    {
      "Sid": "KeepTripChatPrivateToGoViet247Account",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::goviet247-prod/trip-chat/*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalAccount": "122610490382"
        }
      }
    }
  ]
}
